{
    "profile": "golang",
    "extension": "html",
    "indent": 2,
    "preserve_blank_lines": true,
    "max_line_length": 120,
    "max_attribute_length": 80,
    "format_attribute_template_tags": true,
    "linter_output_format": "{filename}:{line}: {code} {message}",
    "ignore": "H006,H021,H030,H031",
    "exclude": ".git,themes,public,resources,node_modules"
}
